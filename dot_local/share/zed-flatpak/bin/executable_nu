#!/bin/sh
# Runs nushell from Homebrew on the host instead of in the toolbox, so
# terminals in Zed open instantly.
#
# host-spawn instead of flatpak-spawn, because nushell needs a terminal it
# controls. It also passes through the variables Zed sets for terminals.
exec "$(dirname "$0")/host-spawn" \
    -env TERM,COLORTERM,TERM_PROGRAM,TERM_PROGRAM_VERSION,ZED_TERM \
    /home/linuxbrew/.linuxbrew/bin/nu "$@"
