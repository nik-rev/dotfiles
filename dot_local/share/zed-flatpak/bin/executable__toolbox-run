#!/bin/sh
# Runs the command this file is invoked as inside a toolbox, so the Zed
# flatpak can use CLIs installed there. Each tool in this directory is a
# symlink to this script.
#
# Set ZED_TOOLBOX to use a toolbox other than the default one.
#
# toolbox run does not pass PATH through, so add ~/.cargo/bin (rustup
# and cargo installed tools) to the PATH of the toolbox.
exec flatpak-spawn --host --watch-bus \
    toolbox run ${ZED_TOOLBOX:+--container "$ZED_TOOLBOX"} \
    sh -c 'PATH="$HOME/.cargo/bin:$PATH" exec "$@"' sh \
    "$(basename "$0")" "$@"
