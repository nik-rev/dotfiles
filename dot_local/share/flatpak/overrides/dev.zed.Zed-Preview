# Flatpak override for Zed Preview. Only used on Fedora Atomic.
# Lives at: ~/.local/share/flatpak/overrides/dev.zed.Zed-Preview
#
# The flatpak already has home access and may run host commands
# (org.freedesktop.Flatpak), so only the environment needs changing.
[Environment]
# zed-flatpak/bin runs nushell on the host. Rust (rustup) and the tools
# from pixi run inside the sandbox directly
PATH=/home/e/.local/share/zed-flatpak/bin:/home/e/.cargo/bin:/home/e/.pixi/bin:/app/bin:/usr/bin
