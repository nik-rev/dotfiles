#!/bin/sh
# Opens Zed. Its command has a different name on every platform, so this
# gives it the same name everywhere
for zed in \
    zed-preview \
    zeditor \
    "$HOME/.local/share/flatpak/exports/bin/dev.zed.Zed-Preview" \
    /var/lib/flatpak/exports/bin/dev.zed.Zed-Preview
do
    if command -v "$zed" >/dev/null 2>&1; then
        exec "$zed" "$@"
    fi
done

printf '%s\n' 'zed: Zed is not installed' >&2
exit 127
