# Files in the repo that aren't dotfiles
README.md
flatpaks.txt
sync-packages.sh
old_dotfiles/

{{ if ne .chezmoi.os "linux" -}}
# Linux desktop stuff: COSMIC, fonts, the session PATH and zed:// links,
# and the SSH agent
.config/cosmic
.config/fontconfig
.bashrc.d
.local/share/applications
.config/systemd/user/sockets.target.wants/ssh-agent.socket
{{ end -}}

{{ if not (includeTemplate "rust-enabled" .) -}}
# Rust, which lives in its own pixi environment
.local/share/rust-env
.local/bin/rust-analyzer
.local/bin/rust-analyzer.cmd
{{ else if eq .chezmoi.os "windows" -}}
.local/bin/rust-analyzer
{{ else -}}
.local/bin/rust-analyzer.cmd
{{ end -}}

{{ if not (and (includeTemplate "is-atomic" .) .login.autologin) -}}
# Starts the keyring (oo7) along with the session, for automatic login
.config/systemd/user/default.target.wants/oo7-daemon.service
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
# macOS only: links from macOS config locations to ~/.config, and the PATH
Library
.zprofile
{{ end -}}
