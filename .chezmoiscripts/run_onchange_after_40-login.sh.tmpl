{{- if includeTemplate "is-atomic" . -}}
#!/bin/sh
# Login on Fedora Atomic: makes the login screen work, and sets up automatic
# login, see login.autologin in .chezmoidata/desktop.toml: {{ .login.autologin }}
#
# With automatic login, COSMIC logs in without asking for a password after
# the disk is unlocked at boot. The keyring (oo7) then unlocks with a random
# password that systemd keeps encrypted, instead of with the login password
set -eu

# -------------------------------
# Login screen
# -------------------------------

# Fedora replaced getty with kmscon as the text console, but cosmic-greeter
# only conflicts with getty: kmscon keeps the display on tty1, and neither
# the login screen nor COSMIC can start. Make it conflict with kmscon too
dropin=/etc/systemd/system/cosmic-greeter.service.d/10-kmscon.conf
dropin_content="# Fedora replaced getty with kmscon as the text console, but cosmic-greeter
# only conflicts with getty: kmscon then keeps the display on tty1, and
# COSMIC cannot start. Added by the dotfiles
[Unit]
Conflicts=kmsconvt@tty1.service
After=kmsconvt@tty1.service"

if [ -e /usr/lib/systemd/system/kmsconvt@.service ] &&
    [ "$(cat "$dropin" 2>/dev/null)" != "$dropin_content" ]; then
    printf '%s\n' "Making the login screen start instead of the kmscon text console"
    sudo mkdir -p "$(dirname "$dropin")"
    printf '%s\n' "$dropin_content" | sudo tee "$dropin" >/dev/null
    sudo systemctl daemon-reload
fi

# -------------------------------
# Automatic login
# -------------------------------

config=/etc/greetd/cosmic-greeter.toml
begin="# BEGIN dotfiles: automatic login"
end="# END dotfiles: automatic login"
block="$begin
[initial_session]
command = \"/usr/bin/start-cosmic\"
user = \"{{ .chezmoi.username }}\"
$end"

current="$(sed -n "/^$begin\$/,/^$end\$/p" "$config")"
wanted="{{ if .login.autologin }}$block{{ end }}"

if [ "$current" != "$wanted" ]; then
    if [ -z "$current" ] && grep -q '^\[initial_session\]' "$config"; then
        printf '%s\n' "Not changing automatic login: $config already has an [initial_session] section" >&2
    else
        printf '%s\n' "Changing automatic login in $config"
        sudo sed -i "/^$begin\$/,/^$end\$/d" "$config"
        if [ -n "$wanted" ]; then
            printf '\n%s\n' "$wanted" | sudo tee -a "$config" >/dev/null
        fi
    fi
fi
{{- if .login.autologin }}

# -------------------------------
# Keyring
# -------------------------------

# oo7 reads this credential to unlock the keyring (ImportCredential in its
# systemd unit). Only systemd on this machine can decrypt it
credential="$HOME/.config/credstore.encrypted/oo7.keyring-encryption-password"
# oo7's keyring, and the one of gnome-keyring, which oo7 replaced
keyrings="$HOME/.local/share/keyrings/v1/login.keyring $HOME/.local/share/keyrings/login.keyring"

existing=""
for keyring in $keyrings; do
    [ -e "$keyring" ] && existing="$keyring"
done

if [ -e "$credential" ]; then
    :
elif [ -n "$existing" ]; then
    # A keyring encrypted with the login password cannot be unlocked with
    # a new random password
    printf '%s\n' "The keyring uses the login password, so it cannot unlock by itself." \
        "To start over with a new keyring, move $existing away and run:" \
        "chezmoi state delete-bucket --bucket=entryState && chezmoi apply" >&2
else
    mkdir -p "$(dirname "$credential")"
    head -c 32 /dev/urandom | base64 | tr -d '\n' |
        systemd-creds encrypt --user --name=oo7.keyring-encryption-password - "$credential"
fi

if [ ! -x /usr/libexec/oo7-daemon ]; then
    printf '%s\n' "The keyring only unlocks by itself with oo7, which newer Fedora" \
        "images have: update with rpm-ostree upgrade" >&2
fi
{{- end }}
{{ end -}}
