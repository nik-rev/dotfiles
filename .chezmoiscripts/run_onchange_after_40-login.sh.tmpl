{{- if includeTemplate "is-atomic" . -}}
#!/bin/sh
# Login on Fedora Atomic. Makes sure the login screen works, and sets up
# automatic login (login.autologin in .chezmoidata/desktop.toml, currently
# {{ .login.autologin }}).
#
# With automatic login, COSMIC logs in without asking for a password once the
# disk is unlocked at boot. Since there's no login password to unlock the
# keyring (oo7) with, it unlocks with a random password that systemd keeps
# encrypted
set -eu

# Changes to system files get collected in this script and run as root at
# the end, so there's at most one password prompt. It lives in the home
# directory because run0 gives root its own /tmp
root_script="$(mktemp -p "$HOME" .dotfiles-root.XXXXXX)"
trap 'rm -f "$root_script"' EXIT
printf '%s\n' "set -eu" >"$root_script"

# -------------------------------
# Login screen
# -------------------------------

# Fedora switched its text console from getty to kmscon, but cosmic-greeter
# only knows to push getty out of the way. kmscon then holds on to the
# display on tty1, and neither the login screen nor COSMIC can start. This
# makes cosmic-greeter push kmscon out of the way too
dropin=/etc/systemd/system/cosmic-greeter.service.d/10-kmscon.conf
dropin_content="# Fedora switched its text console from getty to kmscon, but cosmic-greeter
# only knows to push getty out of the way. kmscon then holds on to the
# display on tty1 and COSMIC can't start. Added by my dotfiles
[Unit]
Conflicts=kmsconvt@tty1.service
After=kmsconvt@tty1.service"

if [ -e /usr/lib/systemd/system/kmsconvt@.service ] &&
    [ "$(cat "$dropin" 2>/dev/null)" != "$dropin_content" ]; then
    printf '%s\n' "Making the login screen start instead of the kmscon text console"
    cat >>"$root_script" <<EOF
mkdir -p $(dirname "$dropin")
cat >$dropin <<'DROPIN'
$dropin_content
DROPIN
systemctl daemon-reload
EOF
fi

# -------------------------------
# Automatic login
# -------------------------------

config=/etc/greetd/cosmic-greeter.toml
begin="# BEGIN dotfiles: automatic login"
end="# END dotfiles: automatic login"
block="$begin
[initial_session]
command = \"/usr/bin/start-cosmic\"
user = \"{{ .chezmoi.username }}\"
$end"

current="$(sed -n "/^$begin\$/,/^$end\$/p" "$config")"
wanted="{{ if .login.autologin }}$block{{ end }}"

if [ "$current" != "$wanted" ]; then
    if [ -z "$current" ] && grep -q '^\[initial_session\]' "$config"; then
        printf '%s\n' "Not changing automatic login: $config already has an [initial_session] section" >&2
    else
        printf '%s\n' "Changing automatic login in $config"
        printf '%s\n' "sed -i '/^$begin\$/,/^$end\$/d' $config" >>"$root_script"
        if [ -n "$wanted" ]; then
            cat >>"$root_script" <<EOF
cat >>$config <<'BLOCK'

$wanted
BLOCK
EOF
        fi
    fi
fi

if [ "$(wc -l <"$root_script")" -gt 1 ]; then
    # secureblue doesn't have sudo, only run0
    if [ -x /usr/bin/sudo ]; then
        sudo sh "$root_script"
    else
        run0 sh "$root_script"
    fi
fi
{{- if .login.autologin }}

# -------------------------------
# Keyring
# -------------------------------

# oo7 unlocks the keyring with this credential (see ImportCredential in its
# systemd unit). Only systemd on this machine can decrypt it
credential="$HOME/.config/credstore.encrypted/oo7.keyring-encryption-password"
# oo7's keyring, and gnome-keyring's, which oo7 replaced
keyrings="$HOME/.local/share/keyrings/v1/login.keyring $HOME/.local/share/keyrings/login.keyring"

existing=""
for keyring in $keyrings; do
    [ -e "$keyring" ] && existing="$keyring"
done

if [ -e "$credential" ]; then
    :
elif [ -n "$existing" ]; then
    # A keyring that's encrypted with the login password can't be unlocked
    # with a new random one
    printf '%s\n' "The keyring uses the login password, so it cannot unlock by itself." \
        "To start over with a new keyring, move $existing away and run:" \
        "chezmoi state delete-bucket --bucket=entryState && chezmoi apply" >&2
else
    mkdir -p "$(dirname "$credential")"
    head -c 32 /dev/urandom | base64 | tr -d '\n' |
        systemd-creds encrypt --user --name=oo7.keyring-encryption-password - "$credential"
fi

if [ ! -x /usr/libexec/oo7-daemon ]; then
    printf '%s\n' "The keyring only unlocks by itself with oo7 (Fedora 45 and newer). With" \
        "gnome-keyring, it asks for the login password after automatic login" >&2
fi
{{- end }}
{{ end -}}
