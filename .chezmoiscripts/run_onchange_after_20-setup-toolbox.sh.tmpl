{{- if includeTemplate "is-atomic" . -}}
#!/bin/bash
# Sets up the toolbox used for compiling Rust on Fedora Atomic. Everyday
# tools are installed on the host with Homebrew instead
set -euo pipefail

container_name={{ .toolbox.name | quote }}

if ! toolbox run --container "$container_name" true >/dev/null 2>&1; then
    toolbox create --assumeyes "$container_name"
fi

# The toolbox only mounts the home directory, and Homebrew binaries only
# work from /home/linuxbrew, so link it to the host copy
toolbox run --container "$container_name" \
    sudo ln -sfn /run/host/var/home/linuxbrew /var/home/linuxbrew

# dnf skips packages that are already installed
toolbox run --container "$container_name" \
    sudo dnf install -y{{ range .toolbox.dnf }} {{ . | quote }}{{ end }}

# The home directory is shared with the toolbox, so the script can be
# passed through a file in it
rust_setup="$(mktemp -p "$HOME" .rust-setup.XXXXXX)"
trap 'rm -f "$rust_setup"' EXIT

cat >"$rust_setup" <<'RUST_SETUP'
{{ template "rust-setup.sh" . }}
RUST_SETUP

toolbox run --container "$container_name" sh "$rust_setup"
{{ end -}}
