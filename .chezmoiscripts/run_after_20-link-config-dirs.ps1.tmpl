{{- if eq .chezmoi.os "windows" -}}
# On Windows, programs look for their config in AppData instead of
# ~/.config, where chezmoi puts it, so those folders get linked to ~/.config.
# This uses junctions, since they don't need admin rights like symlinks do
$ErrorActionPreference = "Stop"

$links = [ordered]@{
    "$env:APPDATA\alacritty"    = "$HOME\.config\alacritty"
    "$env:APPDATA\bat"          = "$HOME\.config\bat"
    "$env:APPDATA\nushell"      = "$HOME\.config\nushell"
    "$env:APPDATA\Zed"          = "$HOME\.config\zed"
    "$env:LOCALAPPDATA\lazygit" = "$HOME\.config\lazygit"
}

foreach ($link in $links.GetEnumerator()) {
    $item = Get-Item -LiteralPath $link.Key -Force -ErrorAction SilentlyContinue

    if ($item -and $item.LinkType -eq "Junction") {
        continue
    }

    # Keep any config the program created before chezmoi ran
    if ($item) {
        Move-Item -LiteralPath $link.Key -Destination "$($link.Key).backup"
    }

    New-Item -ItemType Junction -Path $link.Key -Target $link.Value | Out-Null
}
{{ end -}}
