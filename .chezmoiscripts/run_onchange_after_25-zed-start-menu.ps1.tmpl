{{- if eq .chezmoi.os "windows" -}}
# Adds pixi's Zed to the Start menu and makes zed:// links open in it, the
# way Zed's own installer would. pixi's Zed package only comes with app menu
# entries for Linux and macOS.
#
# Both point at Zed itself rather than pixi's `zed` command in ~/.pixi/bin,
# which is a console program and would open a console window next to Zed
$ErrorActionPreference = "Stop"

$zed = "$HOME\.pixi\envs\zed\bin\zed.exe"

$shortcut = (New-Object -ComObject WScript.Shell).CreateShortcut(
    "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Zed.lnk")
$shortcut.TargetPath = $zed
$shortcut.IconLocation = $zed
$shortcut.Save()

# zed:// links, like the file links from `rg` in nushell. Only for this user
$key = "HKCU:\Software\Classes\zed"
New-Item -Path "$key\shell\open\command" -Force | Out-Null
Set-Item -Path $key -Value "URL:zed Protocol"
Set-ItemProperty -Path $key -Name "URL Protocol" -Value ""
Set-Item -Path "$key\shell\open\command" -Value "`"$zed`" `"%1`""
{{ end -}}
