{{- $atomic := includeTemplate "is-atomic" . -}}
{{- if or $atomic (eq .chezmoi.os "darwin") -}}
#!/bin/bash
# Installs pixi, and the applications it does not provide, on Fedora Atomic
# and macOS
set -euo pipefail

{{ if $atomic -}}
# -------------------------------
# Flatpak applications
# -------------------------------

flatpak --user remote-add --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo

flatpak --user install --noninteractive flathub
{{- range (include "flatpaks.txt" | splitList "\n") }}{{ if and . (not (hasPrefix "#" .)) }} {{ . | quote }}{{ end }}{{ end }}

{{ else -}}
# -------------------------------
# Xcode Command Line Tools
# -------------------------------

# Apple's compiler, linker and SDK, which Rust needs to link, and git. Only
# Apple provides them, so they cannot come from pixi
if ! xcode-select -p >/dev/null 2>&1; then
    # Fails if an installation was already requested, the loop waits either way
    xcode-select --install || true
    printf '%s\n' 'Waiting for the Command Line Tools: click "Install" in the dialog'
    until xcode-select -p >/dev/null 2>&1; do
        sleep 10
    done
fi

# -------------------------------
# Zed
# -------------------------------

if [ ! -d "/Applications/Zed Preview.app" ]; then
    curl -fsSL https://zed.dev/install.sh | ZED_CHANNEL=preview sh
fi

{{ end -}}
# -------------------------------
# pixi
# -------------------------------

# The PATH is set up by these dotfiles instead of the installer
if [ ! -x "$HOME/.pixi/bin/pixi" ]; then
    curl -fsSL https://pixi.sh/install.sh | PIXI_NO_PATH_UPDATE=1 bash
fi
{{ end -}}
