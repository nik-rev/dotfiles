{{- $atomic := includeTemplate "is-atomic" . -}}
{{- if or $atomic (eq .chezmoi.os "darwin") -}}
#!/bin/bash
# Installs pixi on Fedora Atomic and macOS, plus the apps that pixi doesn't
# have
set -euo pipefail

{{ if $atomic -}}
# -------------------------------
# Flatpak applications
# -------------------------------

flatpak --user remote-add --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo

flatpak --user install --noninteractive flathub
{{- range (include "flatpaks.txt" | splitList "\n") }}{{ if and . (not (hasPrefix "#" .)) }} {{ . | quote }}{{ end }}{{ end }}

flatpak --user install --noninteractive flathub
{{- range .fedora.flatpak_extensions }} {{ . | quote }}{{ end }}

# -------------------------------
# Layered packages
# -------------------------------

# Packages the COSMIC image doesn't ship yet. The list is fedora.layered in
# .chezmoidata/packages.toml
status="$(rpm-ostree status --json)"
missing=""

# Each entry is "package:only_with". A package is skipped unless its
# only_with package is installed
for entry in{{ range .fedora.layered }} {{ printf "%s:%s" .package (get . "only_with") | quote }}{{ end }}; do
    package="${entry%%:*}"
    only_with="${entry#*:}"
    if [ -n "$only_with" ] && ! rpm -q "$only_with" >/dev/null 2>&1; then
        continue
    fi

    # Looks at the booted and the staged system. A layered package counts as
    # "requested", and it's "active" unless Fedora's image already has it
    state="$(printf '%s' "$status" | python3 -c '
import json, sys
package = sys.argv[1]
deployments = [d for d in json.load(sys.stdin)["deployments"] if d.get("booted") or d.get("staged")]
requested = any(package in d.get("requested-packages", []) for d in deployments)
active = any(package in d.get("packages", []) for d in deployments)
print("inactive" if requested and not active else "requested" if requested else "none")
' "$package")"

    if [ "$state" = inactive ]; then
        printf '%s\n' "Fedora's image now includes $package: remove it from fedora.layered" \
            "in .chezmoidata/packages.toml, and run: rpm-ostree uninstall $package" >&2
    elif [ "$state" = none ] && ! rpm -q "$package" >/dev/null 2>&1; then
        missing="$missing $package"
    fi
done

if [ -n "$missing" ]; then
    printf '%s\n' "Layering$missing onto the system image"
    # secureblue doesn't have sudo, only run0
    if [ -x /usr/bin/sudo ]; then
        root=sudo
    else
        root=run0
    fi
    # shellcheck disable=SC2086
    $root rpm-ostree install --idempotent $missing
    printf '%s\n' "Reboot to start using$missing"
fi

{{ else -}}
# -------------------------------
# Xcode Command Line Tools
# -------------------------------

# Apple's compiler, linker and SDK, which Rust needs for linking, and git.
# Only Apple distributes these, so pixi can't provide them
if ! xcode-select -p >/dev/null 2>&1; then
    # This fails if an install was already requested, but the loop below waits
    # either way
    xcode-select --install || true
    printf '%s\n' 'Waiting for the Command Line Tools: click "Install" in the dialog'
    until xcode-select -p >/dev/null 2>&1; do
        sleep 10
    done
fi

{{ end -}}
# -------------------------------
# pixi
# -------------------------------

# The dotfiles set up the PATH themselves, so the installer shouldn't
if [ ! -x "$HOME/.pixi/bin/pixi" ]; then
    curl -fsSL https://pixi.sh/install.sh | PIXI_NO_PATH_UPDATE=1 bash
fi
{{ end -}}
