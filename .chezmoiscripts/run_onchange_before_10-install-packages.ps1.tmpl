{{- if eq .chezmoi.os "windows" -}}
# Installs pixi on Windows, plus the apps that pixi doesn't have
$ErrorActionPreference = "Stop"

# Runs a program and stops the whole script if it fails
function Invoke-Checked {
    $program, $arguments = $args
    & $program @arguments
    if ($LASTEXITCODE -ne 0) {
        throw "$program exited with code $LASTEXITCODE"
    }
}

function Install-WingetPackage {
    param([string]$Id, [string[]]$Arguments = @(), [string]$Source = "winget")

    winget list --exact --id $Id --accept-source-agreements *> $null
    if ($LASTEXITCODE -eq 0) {
        Write-Host "$Id is already installed."
        return
    }

    Invoke-Checked winget install --exact --id $Id --source $Source --silent `
        --accept-package-agreements --accept-source-agreements @Arguments
}

# -------------------------------
# winget packages
# -------------------------------

{{ range .windows.winget -}}
Install-WingetPackage {{ . | squote }}
{{ end -}}
{{ if .windows.msstore }}
# Old versions of winget can't reach the Microsoft Store any more, because
# its certificate changed. Windows 11's own winget can be that old until the
# Store gets around to updating it, so update it here if the Store doesn't
# answer
winget show --exact --id {{ first .windows.msstore | squote }} --source msstore `
    --accept-source-agreements *> $null
if ($LASTEXITCODE -ne 0) {
    Write-Host "Updating winget, so it can reach the Microsoft Store"
    Install-PackageProvider -Name NuGet -Force -Scope CurrentUser | Out-Null
    Install-Module Microsoft.WinGet.Client -Force -Scope CurrentUser -Repository PSGallery
    Repair-WinGetPackageManager -Latest -Force
}

{{ range .windows.msstore -}}
Install-WingetPackage {{ . | squote }} -Source msstore
{{ end -}}
{{ end }}
# The C++ build tools and the Windows SDK, which Rust needs for linking
Install-WingetPackage "Microsoft.VisualStudio.2022.BuildTools" @(
    "--override",
    "--wait --passive --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
)

# -------------------------------
# pixi
# -------------------------------

# The installer adds ~/.pixi/bin to the PATH as well
if (-not (Test-Path "$HOME\.pixi\bin\pixi.exe")) {
    Invoke-RestMethod https://pixi.sh/install.ps1 | Invoke-Expression
}

# -------------------------------
# SSH agent
# -------------------------------

# Windows comes with an SSH agent, but it's turned off, and turning it on
# needs admin rights
$agent = Get-Service ssh-agent
if ($agent.StartType -ne "Automatic" -or $agent.Status -ne "Running") {
    Start-Process powershell -Verb RunAs -Wait -WindowStyle Hidden -ArgumentList @(
        "-NoProfile", "-Command",
        "Set-Service ssh-agent -StartupType Automatic; Start-Service ssh-agent"
    )
}

# -------------------------------
# PATH
# -------------------------------

# For commands that come with the dotfiles, like rust-analyzer
$bin = "$HOME\.local\bin"
$path = [Environment]::GetEnvironmentVariable("Path", "User")
if (($path -split ";") -notcontains $bin) {
    [Environment]::SetEnvironmentVariable("Path", "$path;$bin", "User")
}
{{ end -}}
