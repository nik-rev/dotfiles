{{- if eq .chezmoi.os "windows" -}}
# Installs the tools from ~/.pixi/manifests/pixi-global.toml, and runs again
# whenever that file changes:
# {{ include "dot_pixi/manifests/pixi-global.toml.tmpl" | sha256sum }}
$ErrorActionPreference = "Stop"

& "$HOME\.pixi\bin\pixi.exe" global sync
if ($LASTEXITCODE -ne 0) {
    throw "pixi global sync exited with code $LASTEXITCODE"
}
{{ end -}}
