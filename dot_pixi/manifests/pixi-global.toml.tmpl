        cut = "cut"
        date = "date"
        dd = "dd"
        df = "df"
        dir = "dir"
        dircolors = "dircolors"
        dirname = "dirname"
        du = "du"
        echo = "echo"
        env = "env"
        expand = "expand"
        expr = "expr"
        factor = "factor"
        false = "false"
        fmt = "fmt"
        fold = "fold"
        head = "head"
        hostid = "hostid"
        hostname = "hostname"
        join = "join"
        kill = "kill"
        ln = "ln"
