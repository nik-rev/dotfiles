# CLI tools on every platform, installed from conda-forge with pixi. Each
# tool gets its own environment, and `exposed` lists the commands it puts
# in ~/.pixi/bin. `chezmoi apply` runs `pixi global sync` after changes.
#
# Edit with `chezmoi edit ~/.pixi/manifests/pixi-global.toml`. Tools added
# with `pixi global install` are overwritten by the next `chezmoi apply`.
#
# Rust and everything needed to compile it is in its own environment
# instead, see ~/.local/share/rust-env/pixi.toml
version = 1

[envs.bat]
channels = ["conda-forge"]
dependencies = { bat = "*" }
exposed = { bat = "bat" }

[envs.chezmoi]
channels = ["conda-forge"]
dependencies = { chezmoi = "*" }
exposed = { chezmoi = "chezmoi" }

# The package called "fd" is something else
[envs.fd-find]
channels = ["conda-forge"]
dependencies = { fd-find = "*" }
exposed = { fd = "fd" }
{{- if ne .chezmoi.os "windows" }}

# No Windows build
[envs.fish]
channels = ["conda-forge"]
dependencies = { fish = "*" }
exposed = { fish = "fish" }
{{- end }}

[envs.fzf]
channels = ["conda-forge"]
dependencies = { fzf = "*" }
exposed = { fzf = "fzf" }

[envs.git-delta]
channels = ["conda-forge"]
dependencies = { git-delta = "*" }
exposed = { delta = "delta" }

[envs.lazygit]
channels = ["conda-forge"]
dependencies = { lazygit = "*" }
exposed = { lazygit = "lazygit" }

[envs.nushell]
channels = ["conda-forge"]
dependencies = { nushell = "*" }
exposed = { nu = "nu" }

[envs.ripgrep]
channels = ["conda-forge"]
dependencies = { ripgrep = "*" }
exposed = { rg = "rg" }

[envs.typst]
channels = ["conda-forge"]
dependencies = { typst = "*" }
exposed = { typst = "typst" }

[envs.vim]
channels = ["conda-forge"]
dependencies = { vim = "*" }
# The Windows package has no vimdiff
exposed = { vim = "vim", {{ if ne .chezmoi.os "windows" }}vimdiff = "vimdiff", {{ end }}xxd = "xxd" }

[envs.vivid]
channels = ["conda-forge"]
dependencies = { vivid = "*" }
exposed = { vivid = "vivid" }

[envs.yazi]
channels = ["conda-forge"]
dependencies = { yazi = "*" }
exposed = { ya = "ya", yazi = "yazi" }

[envs.zoxide]
channels = ["conda-forge"]
dependencies = { zoxide = "*" }
exposed = { zoxide = "zoxide" }
{{- if eq .chezmoi.os "windows" }}

# GNU coreutils rewritten in Rust (ls, cp, cat, ...), as separate commands.
# Windows' own expand, hostname, more, sort, timeout and whoami come first
# on the PATH. In nushell, its built-in commands like ls come first, so call
# these with a caret: ^ls
[envs.uutils-coreutils]
channels = ["conda-forge"]
dependencies = { uutils-coreutils = "*" }

