# My CLI tools for every platform, installed from conda-forge with pixi.
# Each tool gets its own environment, and `exposed` lists the commands it
# puts in ~/.pixi/bin. After a change, `chezmoi apply` runs `pixi global sync`.
#
# Edit this with `chezmoi edit ~/.pixi/manifests/pixi-global.toml`. Anything
# added with `pixi global install` gets overwritten on the next
# `chezmoi apply`.
#
# Rust, and everything I need to compile it, lives in its own environment
# instead (see ~/.local/share/rust-env/pixi.toml)
version = 1

# Terminal. `shortcuts` puts it in the app menu on every platform
[envs.alacritty]
    channels = ["conda-forge"]
    dependencies = { alacritty = "*" }
    exposed = { alacritty = "alacritty" }
    shortcuts = ["alacritty"]

# Editor. The Windows package doesn't come with an app menu entry, so setup
# adds one to the Start menu there
[envs.zed]
    channels = ["conda-forge"]
    dependencies = { zed = "*" }
    exposed = { zed = "zed" }
    shortcuts = ["zed"]

# A better "cat" (with syntax highlighting)
[envs.bat]
    channels = ["conda-forge"]
    dependencies = { bat = "*" }
    exposed = { bat = "bat" }

# Dotfiles manager
[envs.chezmoi]
    channels = ["conda-forge"]
    dependencies = { chezmoi = "*" }
    exposed = { chezmoi = "chezmoi" }

# Not "fd": the package with that name is something else
[envs.fd-find]
    channels = ["conda-forge"]
    dependencies = { fd-find = "*" }
    exposed = { fd = "fd" }

{{- if ne .chezmoi.os "windows" }}
    # There's no Windows build
    [envs.fish]
        channels = ["conda-forge"]
        dependencies = { fish = "*" }
        exposed = { fish = "fish" }
{{- end }}

[envs.fzf]
    channels = ["conda-forge"]
    dependencies = { fzf = "*" }
    exposed = { fzf = "fzf" }

[envs.git-delta]
    channels = ["conda-forge"]
    dependencies = { git-delta = "*" }
    exposed = { delta = "delta" }

[envs.lazygit]
    channels = ["conda-forge"]
    dependencies = { lazygit = "*" }
    exposed = { lazygit = "lazygit" }

[envs.nushell]
    channels = ["conda-forge"]
    dependencies = { nushell = "*" }
    exposed = { nu = "nu" }

[envs.ripgrep]
    channels = ["conda-forge"]
    dependencies = { ripgrep = "*" }
    exposed = { rg = "rg" }

[envs.typst]
    channels = ["conda-forge"]
    dependencies = { typst = "*" }
    exposed = { typst = "typst" }

[envs.vim]
    channels = ["conda-forge"]
    dependencies = { vim = "*" }
    # The Windows package doesn't include vimdiff
    exposed = { vim = "vim", {{ if ne .chezmoi.os "windows" }}vimdiff = "vimdiff", {{ end }}xxd = "xxd" }

[envs.vivid]
    channels = ["conda-forge"]
    dependencies = { vivid = "*" }
    exposed = { vivid = "vivid" }

[envs.yazi]
    channels = ["conda-forge"]
    dependencies = { yazi = "*" }
    exposed = { ya = "ya", yazi = "yazi" }

[envs.zoxide]
    channels = ["conda-forge"]
    dependencies = { zoxide = "*" }
    exposed = { zoxide = "zoxide" }

{{- if eq .chezmoi.os "windows" }}
    # GNU coreutils rewritten in Rust (ls, cp, cat and so on), as separate
    # commands. Windows' own expand, hostname, more, sort, timeout and whoami win
    # on the PATH, though, and nushell's built-in commands like ls win in
    # nushell, so those are called with a carot (e.g. ^ls)
    [envs.uutils-coreutils]
        channels = ["conda-forge"]
        dependencies = { uutils-coreutils = "*" }

    [envs.uutils-coreutils.exposed]
        "[" = "["
        arch = "arch"
        b2sum = "b2sum"
        base32 = "base32"
        base64 = "base64"
        basename = "basename"
        basenc = "basenc"
        cat = "cat"
        cksum = "cksum"
