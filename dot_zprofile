# Put Homebrew on the PATH. macOS apps like Zed read the environment from
# the login shell, so this makes Homebrew tools available to them too
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
